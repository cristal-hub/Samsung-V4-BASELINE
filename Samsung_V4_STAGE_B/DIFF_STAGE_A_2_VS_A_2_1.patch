+        object.__setattr__(fabricated, "strategy_id", "evil")
+        object.__setattr__(fabricated, "config_hash", "b" * 64)
+        with pytest.raises(AttributionError):
+            stamp({"x": 1}, fabricated)
+        with pytest.raises(AttributionError):
+            AttributionFactory(fabricated)
